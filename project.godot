[application]

config/name="Ontomeme"
config/version="0.1.0"
config/description="Ontomeme — immersive notes, folders and a learning journey, built on Godot"
config/icon="res://Ontomeme_Logo.png"
run/main_scene="res://note.tscn"
config/features=PackedStringArray("4.2", "Forward Plus")

[autoload]

UndoRedoEngine="res://undo_redo.gd"
VaultStore="res://vault_store.gd"
LayerEngine="res://layer_engine.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720

[gui]

theme/custom="res://theme.tres"

[input]

save_note={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":true,"meta_pressed":false,"pressed":false,"keycode":83,"physical_keycode":83,"key_label":0,"unicode":115,"location":0,"echo":false,"script":null)
]
}
new_note={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":true,"meta_pressed":false,"pressed":false,"keycode":78,"physical_keycode":78,"key_label":0,"unicode":110,"location":0,"echo":false,"script":null)
]
}

[rendering]

textures/vram_compression/import_etc2_astc=true
