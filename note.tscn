[gd_scene load_steps=3 format=3]

[ext_resource type="Script" path="res://note.gd" id="1_note"]
[ext_resource type="Script" path="res://GraphLayer.gd" id="2_graph"]

[node name="Root" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
